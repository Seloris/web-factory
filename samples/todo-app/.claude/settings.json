{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "allow": [
      "Bash(node *scripts/timestamp.mjs)",
      "Bash(node *scripts/manifest.mjs*)",
      "Bash(node *scripts/spec-check.mjs*)",
      "Bash(node *scripts/run.mjs*)",
      "Bash(node *scripts/settings.mjs)",
      "Bash(node *scripts/ops.mjs* mark*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "PowerShell(git push:*)",
      "PowerShell(git -C * push*)",
      "PowerShell(git -c * push*)"
    ]
  },
  "enabledPlugins": {
    "selo@selo": true
  },
  "extraKnownMarketplaces": {
    "selo": {
      "source": {
        "source": "directory",
        "path": "C:/WS/webapp-factory"
      }
    }
  }
}
