{
  "permissions": {
    "allow": [
      "Bash(node *scripts/timestamp.mjs)",
      "Bash(node *scripts/manifest.mjs*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git * push:*)",
      "PowerShell(git push:*)",
      "PowerShell(git * push:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "selo-flow": {
      "source": {
        "source": "directory",
        "path": "C:/WS/webapp-factory"
      }
    }
  },
  "enabledPlugins": {
    "selo-flow@selo-flow": true,
    "selo-flow-board@selo-flow": true
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  }
}
