<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>RosterComp.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>RosterComp.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>
</Project>
