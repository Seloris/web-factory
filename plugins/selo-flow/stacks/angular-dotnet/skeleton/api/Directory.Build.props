<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>{{namespace}}.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>{{namespace}}.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>
</Project>
