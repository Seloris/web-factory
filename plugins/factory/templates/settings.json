{
  "permissions": {
    "allow": [
      "Bash(node *scripts/timestamp.mjs)",
      "Bash(node *scripts/manifest.mjs*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git * push:*)",
      "PowerShell(git push:*)",
      "PowerShell(git * push:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "{{runner_model}}"
  },
  "enabledPlugins": {
    "factory@webapp-factory": true
  }
}
